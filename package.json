{
  "name": "attest",
  "version": "0.1.0",
  "description": "Open-source Obsidian plugin for AI deep research over your vault with verifiable citations.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "styles": "node scripts/build-styles.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
    "test": "vitest run",
    "release:check": "node scripts/release-check.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --check .",
    "check": "npm run typecheck && npm run typecheck:core && npm run test:coverage && npm run depcruise && npm run format && npm run build",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "keywords": [
    "obsidian",
    "lm-studio",
    "ollama",
    "research"
  ],
  "author": "altavelor",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "^5.3.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "obsidian": "^1.5.12",
    "prettier": "^3.3.2",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "franc-min": "^6.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.44.0",
    "pdfjs-dist": "^6.0.227"
  }
}
