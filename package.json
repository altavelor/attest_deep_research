{
  "name": "attest",
  "version": "0.4.5",
  "description": "Open-source Obsidian plugin for cited AI deep research across your vault and the web.",
  "private": true,
  "engines": {
    "node": ">=22.15"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "styles": "node scripts/build-styles.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/check-bundle.mjs",
    "test": "vitest run",
    "release:check": "node scripts/release-check.mjs",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/test-results.json && npm run test:density",
    "test:density": "node scripts/test-density.mjs",
    "test:growth": "node scripts/test-growth.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "depcruise": "node scripts/depcruise.mjs",
    "format": "prettier --check .",
    "check": "npm run typecheck && npm run typecheck:core && npm run test:coverage && npm run depcruise && npm run format && npm run build",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "keywords": [
    "obsidian",
    "lm-studio",
    "ollama",
    "research"
  ],
  "author": "altavelor",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.7.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "obsidian": "^1.14.4",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tslib": "^2.6.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "franc-min": "^6.2.0",
    "ollama": "^0.6.4",
    "openai": "^7.39.0"
  }
}
