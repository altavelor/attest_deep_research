# Blocking AI-review gate.
#
# On every PR event it runs the review prompt (.github/agent/review.md) and
# expects the model to end its report with "VERDICT: PASS" or "VERDICT: FAIL".
#   - FAIL  -> the "agent-review" status check fails (blocks merge); the local
#             fixer loop (scripts/review-loop.sh) reacts to this and iterates.
#   - PASS  -> the "agent-review" status check succeeds.
#
# Requirements to activate:
#   1. Repository secret OPENAI_API_KEY (platform.openai.com key).
#      Without it the review job is skipped and the gate is a no-op (never blocks).
#
# The "Run review" step is vendor-specific (OpenAI Codex action). To use another
# CLI, replace it with a runner that consumes .github/agent/review.md and writes
# agent-review.md ending in a VERDICT line.

name: Agent Review Gate

on:
  pull_request:
    types:
      - opened
      - synchronize
      - reopened
      - ready_for_review

concurrency:
  group: agent-review-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  review:
    name: agent-review
    runs-on: ubuntu-latest

    permissions:
      contents: read

    steps:
      - name: Check for API key
        id: guard
        shell: bash
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        run: |
          if [[ -z "${OPENAI_API_KEY:-}" ]]; then
            echo "enabled=false" >>"$GITHUB_OUTPUT"
            echo "::warning::OPENAI_API_KEY is not set; skipping the review gate (no-op pass)."
          else
            echo "enabled=true" >>"$GITHUB_OUTPUT"
          fi

      - name: Checkout pull request merge commit
        if: steps.guard.outputs.enabled == 'true'
        uses: actions/checkout@v6
        with:
          ref: refs/pull/${{ github.event.pull_request.number }}/merge
          fetch-depth: 0
          persist-credentials: false

      # Vendor-specific step. Replace with your CLI of choice if not using Codex.
      - name: Run review
        if: steps.guard.outputs.enabled == 'true'
        uses: openai/codex-action@v1
        with:
          openai-api-key: ${{ secrets.OPENAI_API_KEY }}
          prompt-file: .github/agent/review.md
          output-file: agent-review.md
          sandbox: read-only
          codex-args: '["--ephemeral"]'

      - name: Display review
        if: always() && steps.guard.outputs.enabled == 'true'
        shell: bash
        run: cat agent-review.md

      - name: Read verdict
        id: verdict
        if: steps.guard.outputs.enabled == 'true'
        shell: bash
        run: |
          verdict="$(grep -E '^VERDICT: (PASS|FAIL)$' agent-review.md | tail -n 1 || true)"
          echo "value=${verdict}" >>"$GITHUB_OUTPUT"
          if [[ "$verdict" == "VERDICT: PASS" ]]; then
            echo "pass=true" >>"$GITHUB_OUTPUT"
          else
            echo "pass=false" >>"$GITHUB_OUTPUT"
          fi

      - name: Upload review artifact
        if: always() && steps.guard.outputs.enabled == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: agent-review-${{ github.event.pull_request.number }}
          path: agent-review.md

      - name: Enforce verdict
        if: steps.guard.outputs.enabled == 'true'
        shell: bash
        run: |
          if [[ "${{ steps.verdict.outputs.pass }}" != "true" ]]; then
            echo "::error::Agent review did not pass (${{ steps.verdict.outputs.value }})"
            exit 1
          fi
