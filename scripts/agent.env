# Agent automation configuration.
#
# This file makes the task/publish scripts CLI-neutral: they read the command
# used to launch the coding agent and the pull-request review trigger from here
# instead of hardcoding a single vendor. Copy/adjust the values for whichever
# CLI you use (Codex, Claude Code, Gemini, Aider, a local runner, etc.).
#
# Every value can be overridden by exporting the same variable in the
# environment before running a script, e.g.:
#   AGENT_EXEC_CMD='claude -p' scripts/agent-task.sh 42
#
# The scripts source this file, so use plain KEY=value assignments only.

# Base branch that task branches are created from and reviewed against.
BASE_BRANCH="main"

# Command that runs the coding agent non-interactively on a single prompt.
# The scripts pipe the normalized task prompt to this command on STDIN, so it
# must accept the prompt from STDIN. Examples:
#   Codex CLI:   AGENT_EXEC_CMD='codex exec -'
#   Claude Code: AGENT_EXEC_CMD='claude -p'
#   Aider:       AGENT_EXEC_CMD='aider --message-file -'
# Leave empty to only prepare the branch/prompt and print it (no agent run).
AGENT_EXEC_CMD="codex exec -"

# Comment posted on the pull request to trigger an independent AI review.
# This is vendor-specific; set it to whatever your review integration expects.
#   Codex:  REVIEW_TRIGGER='@codex review'
#   Claude: REVIEW_TRIGGER='@claude review'
# Leave empty to skip posting an automated review trigger.
REVIEW_TRIGGER="@codex review"
