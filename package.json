{
  "name": "ixplorer",
  "version": "0.1.0",
  "description": "Local-first LM Studio research assistant for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "styles": "node scripts/build-styles.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --check ."
  },
  "keywords": [
    "obsidian",
    "lm-studio",
    "ollama",
    "research"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "builtin-modules": "^3.3.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.21.5",
    "obsidian": "^1.5.12",
    "prettier": "^3.3.2",
    "tslib": "^2.6.3",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "franc-min": "^6.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.44.0",
    "pdfjs-dist": "^6.0.227"
  }
}
